<Window x:Class="LyricsHelper.WindowText"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LyricsHelper"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d" Height="300" Width="400" ResizeMode="CanResizeWithGrip"
        Title="WindowText" SizeToContent="Manual">
    <DockPanel>
        <TextBox x:Name="textbox" IsReadOnly="True" PreviewMouseWheel="Textbox_MouseWheel" />
    </DockPanel>
</Window>
